# Entry point of the xmens pipeline: reads config/config.yaml and config/samples.tsv,
# pins the shared wildcards, includes the stage rule files and declares the default
# target (rule all). Arms outside rule all expose their own *_all target rules.

import pandas as pd
configfile: "config/config.yaml"
samples = pd.read_csv("config/samples.tsv", sep="\t").set_index("sample_id", drop=False)
SPECIES   = sorted(samples["species"].unique())
SLIDETAGS = list(samples.index[samples["modality"] == "slidetags"])

# Pin wildcards so latent_{species}.h5ad (stage 02) cannot swallow
# latent_{species}_{lineage}.h5ad (stage 04b). Without this, `integrate`
# matches species="mouse_perimetrium" and the DAG goes off a cliff.
wildcard_constraints:
    species="human|mouse",
    lineage="epithelial|immune|perimetrium|perivascular|smc|stromal|vascular",


# Raw per-sample objects of one species. Shadowed by the definition in 01c_concat.smk
# (QC'd objects), which rule concat uses.
def species_samples(w):
    ids = samples.index[samples["species"] == w.species]
    return expand("data/interim/raw/{sample}.h5ad", sample=ids)


# The spine, in stage order. Helper functions defined in these files (lineage_latents,
# spatial_qc_targets, LINEAGE_RES) are used by rule all and by later rule files.
for r in ["00a_slidetags","00_cellbender","00b_ingest","01_qc","01c_concat","01b_qc_report","02_integrate",
          "04_annotate","04b_reintegrate","04c_reannotate","98_clustree","04d_merge","04e_reembed","04f_spatial_qc","05_de","06_pseudotime","06b_timepoint_pseudotime","07_spatial_pseudotime",
          "08_cellrank","09_pt_genes_mi","21_scenic",
          "22_crossspecies","23_invitro","90_figures","09_homology","10_samap"]:
    include: f"rules/{r}.smk"


# Default target. Implemented today: the per-lineage scVI latents (04b) and the spatial
# QC objects (04f). The marker, MI, SCENIC, conservation, pseudotime, CellRank, in-vitro and
# figure inputs are produced by stub rules (de, pt_genes_mi, scenic, crossspecies,
# pseudotime_global, cellrank, spatial_pseudotime, invitro, figures) that exit with an error.
rule all:
    input:
        *lineage_latents(),          # 04b per-lineage latents
        expand("results/tables/markers_{sp}.csv", sp=SPECIES),
        expand("results/tables/mi_{sp}.csv", sp=SPECIES),
        expand("results/tables/scenic_{sp}.csv", sp=SPECIES),
        "results/tables/conservation.csv",
        "data/interim/pt/global_mouse.h5ad",
        "data/interim/pt/cellrank_mouse.h5ad",
        expand("data/interim/pt/spatial_{s}.h5ad", s=SLIDETAGS),
        *spatial_qc_targets(),       # 04f spatial-coordinate QC (mouse; after annotation)
        "results/tables/invitro_comparison.csv",
        "results/figures/.done",


# Arms downstream of the spine. None is in rule all; each file names its own target
# (mi_all, spatial_gp_all, scenic_all, pt_per_timepoint_all, samap_raw_all,
# finalize_deliverables, zone_modules_all) and documents how it is run.
include: "rules/11_mi_pseudotime.smk"
include: "rules/12_spatial_gp.smk"
include: "rules/13_scenic.smk"
include: "rules/15_pt_per_timepoint.smk"
include: "rules/10b_samap_raw.smk"
include: "rules/04g_deliverables.smk"
# Decidual-zone AUCell modules (mouse); target zone_modules_all.
include: "rules/16_zone_modules.smk"
